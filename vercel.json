{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/artikel",
      "dest": "/artikel/index.html"
    },
    {
      "src": "/artikel/(.*)",
      "dest": "/artikel/$1"
    },
    {
      "src": "/admin",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
