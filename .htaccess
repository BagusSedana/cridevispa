# ══════════════════════════════════════════════════════════════════════════
# CrideviSPA — Server Hardening & Security Configuration (.htaccess)
# ══════════════════════════════════════════════════════════════════════════

# 1. Disable Directory Browsing
Options -Indexes

# 2. Block access to hidden files and directories (like .git, .env)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# 3. Block access to sensitive server scripts & project metadata
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|ps1|sh|sql|sw[op]|json|lock))$">
  Order allow,deny
  Deny from all
</FilesMatch>

# 4. Security Headers
<IfModule mod_headers.c>
  # Prevent MIME sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Prevent Clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  
  # XSS Filter Protection
  Header set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Remove server signature
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# 5. Enable GZIP Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 6. Browser Caching for Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
